      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(app_requests_total{method=\"POST\", endpoint=\"/orders\", http_status!~\"2..\"}[5m])) / sum(rate(app_requests_total{method=\"POST\", endpoint=\"/orders\"}[5m]))",
          "legendFormat": "error rate",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
